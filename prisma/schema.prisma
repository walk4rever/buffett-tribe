generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Source {
  id           String   @id @default(cuid())
  year         Int
  type         String   @default("shareholder")
  date         String?
  title        String
  url          String
  contentMd    String?
  videoUrl     String?
  videoSource  String?
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  chunks       Chunk[]

  @@unique([year, type, date])
}

model InsightPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  source      String?
  sourceUrl   String?
  author      String?
  publishedAt DateTime?
  tags        String[]  @default([])
  entityIds   String[]  @default([])
  format      String    @default("markdown")
  contentRaw  String
  contentHtml String?
  status      String    @default("published")
  externalId  String?   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([status, updatedAt])
}

model Chunk {
  id            String                   @id @default(cuid())
  sourceId      String
  order         Int
  title         String? // sectionEn: e.g. "Non-Insurance Operations > See's Candies"
  sectionZh     String? // e.g. "非保险经营 > 喜诗糖果店"
  contentEn     String
  contentZh     String?
  skipEmbedding Boolean                  @default(false)
  embedding     Unsupported("vector")?
  searchVector  Unsupported("tsvector")?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  source        Source                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, order])
}

model ChatUsage {
  id        String   @id @default(cuid())
  ip        String
  userId    String? // null = anonymous (count by IP); set = authenticated (count by userId)
  date      String
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([ip, date])
  @@unique([userId, date])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  contact   String
  source    String?
  createdAt DateTime @default(now())
}

model ChatMessage {
  id             String   @id @default(cuid())
  ip             String
  userId         String?
  question       String
  answer         String?
  sourceIds      String[] @default([])
  sourcesJson    Json? // snapshot of ChatSource[] for history restoration
  taskType       String? // "fact" | "method"
  needsRetrieval Boolean  @default(true)
  rating         Int? // 1 = thumbs up, -1 = thumbs down
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================================
// Longitudinal Narrative — multi-source intelligence layer
// See PRODUCT.md "标的纵向叙事" section for the full design.
// All entities anchored on SEC CIK to unify EDGAR / 13F / letter mentions.
// ============================================================================

model Entity {
  id            String   @id @default(cuid())
  type          String // 'company' | 'security' | 'master' | 'concept'
  canonicalName String
  aliases       String[] @default([])
  cik           String?  @unique // SEC Central Index Key (US companies + filers)
  tribeId       String?  @unique // 'buffett' | 'lilu' | 'duan' — links to TRIBE_MEMBERS
  ticker        String?
  market        String? // 'us' | 'hk' | 'cn' — exchange market; cik is us-only
  code          String? // exchange-specific code: 'AAPL' (us), '00700' (hk), '600519' (cn)
  sector        String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  financials                  Financial[]
  filingSections              FilingSection[]
  filingAttachments           FilingAttachment[]
  holdingsAsHolder            Holding[]               @relation("HolderEntity")
  securitiesAsCompany         Security[]              @relation("SecurityCompany")
  extSourcesAsFiler           ExtSource[]
  analyses                    CompanyAnalysis[]
  profile                     MasterProfile?
  filerAsFiler                Filer?                  @relation("FilerFilerEntity")
  filerAsCompany              Filer?                  @relation("FilerCompanyEntity")
  beneficialOwnershipAsIssuer BeneficialOwnership[]
  punchesAsFiler              Punch[]                 @relation("PunchFilerEntity")
  punchesAsCompany            Punch[]                 @relation("PunchCompanyEntity")

  @@index([type])
  @@index([ticker])
  @@index([market, code])
}

// Punch ("打孔") = a curated, forward-looking record of a master's proven big-bet
// judgment — named after Buffett's "20 punches in a lifetime" metaphor. Not a
// retrospective case study: a punch is meant to be watched going forward, so it
// carries a `status` that can change as new data comes in (see `filerEntityId`/
// `companyEntityId` below). Current position size is deliberately NOT stored here
// — it's computed live from `Holding` at read time so it can never go stale.
model Punch {
  id              String   @id @default(cuid())
  slug            String   @unique
  filerEntityId   String? // Entity(type=master), e.g. Duan Yongping — enables live 13F lookups
  companyEntityId String? // Entity(type=company), e.g. Apple
  source          String // 'curated' | '13f_derived' | 'user_submitted'
  status          String   @default("active") // 'active' | 'exited' | 'thesis_broken'
  punchYear       Int? // earliest year we can confirm the investor seriously placed this bet — not necessarily the exact first-buy date, just the earliest verifiable evidence of conviction
  headline        String // one-line judgment shown on the wall card
  thesis          String // why this counts as a "punch" — narrative
  catalyst        String?
  valuation       String?
  risk            String?
  quotes          Json? // [{ text, date, sourceTitle, sourceUrl? }] — verbatim citations, not paraphrase
  entrySummary    String? // short "how/when this bet was made" note
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  filerEntity   Entity? @relation("PunchFilerEntity", fields: [filerEntityId], references: [id], onDelete: SetNull)
  companyEntity Entity? @relation("PunchCompanyEntity", fields: [companyEntityId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([filerEntityId])
  @@index([companyEntityId])
}

// Filer = a fund/investment vehicle that submits 13F on behalf of a tracked
// investor. Kept as a companion table (not a physical FK retarget) so that
// downstream "resolve a ticker/CIK to a company" queries never have to
// consider a filer's Entity(type=master) row as a company candidate.
// companyEntityId is set only when the filer is itself a public operating
// company (currently: Berkshire Hathaway / buffett) — see TODOS.md.
model Filer {
  id              String   @id @default(cuid())
  tribeId         String   @unique
  name            String
  filerCik        String?  @unique
  filerEntityId   String   @unique
  companyEntityId String?  @unique
  isMasterPersona Boolean  @default(true) // true = buffett/lilu/duan (core, has wisdom + /master page); false = gavin-baker/alex-sacerdote (alpha, filer only)
  // Curated presentation fields consumed by src/lib/tribe.ts — the DB-driven
  // source of truth for what used to be the hardcoded TRIBE_MEMBERS array, so
  // onboarding a new investor makes them appear site-wide with no code change.
  personNameEn  String? // e.g. "Warren Buffett" — distinct from `name`, which is the firm/fund name
  personNameZh  String? // e.g. "巴菲特"
  initials      String? // 2-char avatar label, e.g. "巴" / "TS"
  materialLabel String  @default("访谈与观点")
  materialSub   String  @default("建设中")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  filerEntity   Entity  @relation("FilerFilerEntity", fields: [filerEntityId], references: [id], onDelete: Cascade)
  companyEntity Entity? @relation("FilerCompanyEntity", fields: [companyEntityId], references: [id], onDelete: SetNull)
}

model Security {
  id              String   @id @default(cuid())
  companyEntityId String? // links to Entity(type='company'|'master via fallback metadata)
  ticker          String?
  cusip           String?  @unique
  shareClass      String?
  titleOfClass    String?
  exchange        String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Entity?   @relation("SecurityCompany", fields: [companyEntityId], references: [id], onDelete: SetNull)
  holdings Holding[]

  @@index([ticker])
  @@index([companyEntityId])
}

model ExtSource {
  id              String    @id @default(cuid())
  kind            String // '10k' | '10q' | '13f' | 'xbrl' | 'price' | 'sc13d' | 'sc13d-a' | 'sc13g' | 'sc13g-a'
  url             String?
  ts              DateTime?
  periodYear      Int? // e.g. 2025 — calendar year of the reporting period
  periodQuarter   Int? // 1–4 — quarter of the reporting period
  filedAt         DateTime? // SEC EDGAR accepted date
  filerEntityId   String?
  accessionNumber String? // SEC accession number, promoted out of metadata so we can enforce uniqueness per filer
  metadata        Json? // 扩展：完整的 SEC filing 元数据（accession、form、fileNumber、filmNumber、size、isXBRL、primaryDocument、acceptanceDateTime、act 等）
  createdAt       DateTime  @default(now())

  filer                 Entity?                      @relation(fields: [filerEntityId], references: [id], onDelete: SetNull)
  financials            Financial[]
  holdings              Holding[]
  sections              FilingSection[]
  attachments           FilingAttachment[]
  artifacts             FilingArtifact[]
  sectionExtractionJobs FilingSectionExtractionJob[]
  beneficialOwnership   BeneficialOwnership?

  @@unique([filerEntityId, accessionNumber], name: "ExtSource_filer_accession_unique")
  @@index([kind, ts])
  @@index([filerEntityId])
}

// Schedule 13D / 13D-A / 13G / 13G-A beneficial-ownership disclosures — event-triggered
// (crossing a 5%/10% threshold), distinct from Holding's quarterly 13F snapshot: this
// reports % of the ISSUER's share class, not % of the filer's own portfolio. One row per
// filing, for the tracked filer's own reported stake only (not other members of a joint
// group filing — see ExtSource.metadata for the full raw payload if needed later).
model BeneficialOwnership {
  id                     String    @id @default(cuid())
  sourceId               String    @unique
  issuerEntityId         String? // matched by Entity.cik when the issuer is already onboarded; null otherwise
  issuerCik              String
  issuerName             String
  issuerTicker           String?
  securitiesClassTitle   String?
  eventDate              DateTime? // dateOfEvent / eventDateRequiresFilingThisStatement
  sharesOwned            BigInt?
  percentOfClass         Float?
  soleVotingPower        BigInt?
  sharedVotingPower      BigInt?
  soleDispositivePower   BigInt?
  sharedDispositivePower BigInt?
  isGroupFiling          Boolean   @default(false)
  createdAt              DateTime  @default(now())

  source ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  issuer Entity?   @relation(fields: [issuerEntityId], references: [id], onDelete: SetNull)

  @@index([issuerCik])
}

model FilingSectionExtractionJob {
  id                String    @id @default(cuid())
  sourceId          String
  extractionVersion Int
  status            String    @default("pending") // pending | running | success | failed | no_sections
  attempts          Int       @default(0)
  maxAttempts       Int       @default(1)
  sectionCount      Int       @default(0)
  lastError         String?
  lastErrorCode     String?
  workerId          String?
  lockedAt          DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  nextRunAt         DateTime?
  lastDurationMs    Int?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  source ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, extractionVersion])
  @@index([status, nextRunAt])
  @@index([sourceId])
  @@index([updatedAt])
}

model Financial {
  id            String   @id @default(cuid())
  entityId      String
  sourceId      String
  periodEnd     DateTime
  periodType    String // 'FY' | 'Q1' | 'Q2' | 'Q3' | 'Q4'
  lineItem      String // 'Revenue' | 'NetIncome' | 'FreeCashFlow' | 'EPSDiluted' | 'TotalAssets' | 'OperatingCashFlow'
  value         Decimal?
  unit          String?
  rawXbrlTag    String?
  sourceFactIds String[] @default([]) // R2 data_file artifact objectKeys (blood lineage)
  mappingRule   String? // 如 "us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax"
  confidence    Float    @default(1) // 1 = 直接映射，0.5 = 多事实聚合/推断
  createdAt     DateTime @default(now())

  entity Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([entityId, periodEnd, periodType, lineItem])
  @@index([entityId, periodEnd])
}

model FilingSection {
  id       String @id @default(cuid())
  entityId String
  sourceId String // 关联 ExtSource

  section     String // "item_1_business" | "item_1a_risk_factors" | "item_2_properties" | "item_3_legal" | "item_7_mda" | "item_7a_market_risk" | "item_8_notes" | "exhibits"
  content     String // 兼容字段：新架构下保存 preview / lightweight fallback，完整文本在 textArtifact
  rawHtml     String? // 兼容字段：新架构下不再保存大 HTML，完整片段在 htmlArtifact
  outlineJson Json? // 目录树 / 标题层级
  blocksJson  Json? // 兼容字段：新架构下保存去掉 html 的轻量 blocks，完整结构在 blocksArtifact

  contentPreview    String?
  contentTextLength Int     @default(0)
  blockCount        Int     @default(0)
  extractionVersion Int     @default(1)

  textArtifactId   String?
  blocksArtifactId String?
  htmlArtifactId   String?

  extractedAt DateTime @default(now())

  entity         Entity          @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source         ExtSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  textArtifact   FilingArtifact? @relation("FilingSectionTextArtifact", fields: [textArtifactId], references: [id], onDelete: SetNull)
  blocksArtifact FilingArtifact? @relation("FilingSectionBlocksArtifact", fields: [blocksArtifactId], references: [id], onDelete: SetNull)
  htmlArtifact   FilingArtifact? @relation("FilingSectionHtmlArtifact", fields: [htmlArtifactId], references: [id], onDelete: SetNull)

  @@unique([sourceId, section])
  @@index([entityId, section])
  @@index([textArtifactId])
  @@index([blocksArtifactId])
  @@index([htmlArtifactId])
}

model FilingAttachment {
  id       String @id @default(cuid())
  entityId String
  sourceId String // 关联 ExtSource（主 10-K）

  sequence     String // "1" | "2" | "3.1" | "10.1"
  description  String // "Restated Articles of Incorporation"
  documentType String // "EX-3.1" | "EX-10.1" | "EX-21"
  documentName String // 文件名
  url          String // SEC 附件 URL

  createdAt DateTime @default(now())

  entity Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([entityId])
}

model FilingArtifact {
  id           String   @id @default(cuid())
  sourceId     String
  kind         String // Standard import writes primary_html | index_html | section_text | section_blocks. Other kinds are legacy/on-demand.
  objectKey    String   @unique
  contentType  String
  sizeBytes    BigInt
  sha256       String
  originalName String?
  sourceUrl    String?
  publicUrl    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  source            ExtSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  textForSections   FilingSection[] @relation("FilingSectionTextArtifact")
  blocksForSections FilingSection[] @relation("FilingSectionBlocksArtifact")
  htmlForSections   FilingSection[] @relation("FilingSectionHtmlArtifact")

  @@index([sourceId, kind])
  @@index([sha256])
}

model Holding {
  id                 String   @id @default(cuid())
  holderEntityId     String
  securityId         String
  sourceId           String
  asOfDate           DateTime
  shares             BigInt?
  valueUsd           BigInt?
  percentOfPortfolio Float?
  isNewPosition      Boolean? @default(false)
  isSoldOut          Boolean? @default(false)
  positionChangePct  Float?
  createdAt          DateTime @default(now())

  holder   Entity    @relation("HolderEntity", fields: [holderEntityId], references: [id], onDelete: Cascade)
  security Security  @relation(fields: [securityId], references: [id], onDelete: Cascade)
  source   ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([holderEntityId, securityId, asOfDate])
  @@index([securityId, asOfDate])
  @@index([holderEntityId, asOfDate])
}

model CompanyNameMap {
  id          String   @id @default(cuid())
  keyType     String // 'ticker' | 'issuer'
  key         String
  nameZh      String?
  ticker      String?
  nameEnShort String?
  source      String? // 'code-dictionary' | 'manual' | 'import'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([keyType, key])
  @@index([keyType, ticker])
}

model MasterProfile {
  id          String   @id @default(cuid())
  entityId    String   @unique
  profile     Json
  source      String   @default("llm")
  version     Int      @default(1)
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
}

// One field = one independently-regenerable unit (one generate-*.ts script /
// one LLM call each) — not split by content shape (prose vs structured).
// All 5 nullable: a company can have any subset generated so far.
model CompanyAnalysis {
  id         String   @id @default(cuid())
  entityId   String   @unique
  profile    Json? // { title, content } — generate-company-profile.ts
  business   Json? // { narrative: {title, content}, canvas: {...9 sections...} } — generate-business-model.ts
  moat       Json? // { summary, dimensions, notes } — generate-value-analysis.ts
  management Json? // capital allocation behavior — generate-management-analysis.ts
  valuation  Json? // scenarios, multiples — generate-valuation-analysis.ts
  source     String   @default("claude")
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
}

// Company-scoped artifacts (company_profile | business_overview | value_analysis |
// management_analysis | valuation_analysis) no longer write here — they live
// directly on CompanyAnalysis. This table now only serves master | portfolio scope
// (master_profile | portfolio_insight).
model GeneratedContentVersion {
  id            String   @id @default(cuid())
  scopeType     String // entity | master | portfolio | other
  scopeId       String
  artifactType  String // master_profile | portfolio_insight
  versionSeq    Int
  payload       Json
  source        String   @default("llm")
  promptVersion String
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([scopeType, scopeId, artifactType, versionSeq])
  @@index([scopeType, scopeId, artifactType])
  @@index([artifactType])
}

model PortfolioInsight {
  id          String   @id @default(cuid())
  masterId    String
  year        Int
  quarter     Int
  structured  Json?
  narrative   String
  source      String   @default("deepseek")
  version     Int      @default(1)
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([masterId, year, quarter])
  @@index([masterId])
}

model HomeSignalSnapshot {
  id            String   @id @default(cuid())
  scope         String   @unique
  sourceQuarter String?
  payload       Json
  version       Int      @default(1)
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StockPrice {
  id            String   @id @default(cuid())
  ticker        String
  date          DateTime @db.Date
  open          Decimal? @db.Decimal(18, 6)
  high          Decimal? @db.Decimal(18, 6)
  low           Decimal? @db.Decimal(18, 6)
  close         Decimal  @db.Decimal(18, 6)
  volume        BigInt?
  adjustedClose Decimal? @db.Decimal(18, 6)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ticker, date])
}

// ============================================================================
// Document — master PDF / speech / article library (formerly hardcoded in src/lib/documents.ts)
// ============================================================================

model Document {
  id         String   @id @default(cuid())
  ownerId    String // Filer.tribeId; core masters (buffett/duan/lilu) by default, plus any Alpha master given a one-off document (e.g. bill-ackman)
  title      String
  subtitle   String?
  badge      String? // '书籍' | '演讲' | '文章'
  rawPath    String // R2 object key for the raw PDF
  readerPath String // Next.js reader route, e.g. /documents/buffett/unscripted
  apiPath    String // API route, e.g. /api/documents/buffett/unscripted
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ownerId])
}
