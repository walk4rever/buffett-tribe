generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Source {
  id           String   @id @default(cuid())
  year         Int
  type         String   @default("shareholder")
  date         String?
  title        String
  url          String
  contentMd    String?
  videoUrl     String?
  videoSource  String?
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  chunks       Chunk[]

  @@unique([year, type, date])
}

model Chunk {
  id            String                   @id @default(cuid())
  sourceId      String
  order         Int
  title         String? // sectionEn: e.g. "Non-Insurance Operations > See's Candies"
  sectionZh     String? // e.g. "非保险经营 > 喜诗糖果店"
  contentEn     String
  contentZh     String?
  skipEmbedding Boolean                  @default(false)
  embedding     Unsupported("vector")?
  searchVector  Unsupported("tsvector")?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  source        Source                   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, order])
}

model ChatUsage {
  id        String   @id @default(cuid())
  ip        String
  userId    String? // null = anonymous (count by IP); set = authenticated (count by userId)
  date      String
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([ip, date])
  @@unique([userId, date])
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  contact   String
  source    String?
  createdAt DateTime @default(now())
}

model ChatMessage {
  id             String   @id @default(cuid())
  ip             String
  userId         String?
  question       String
  answer         String?
  sourceIds      String[] @default([])
  sourcesJson    Json? // snapshot of ChatSource[] for history restoration
  taskType       String? // "fact" | "method"
  needsRetrieval Boolean  @default(true)
  rating         Int? // 1 = thumbs up, -1 = thumbs down
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DigitalHumanProfile {
  id           String            @id @default(cuid())
  key          String            @unique
  name         String
  provider     String            @default("mock")
  status       String            @default("active")
  faceImageUrl String?
  voiceProfile String?
  providerMeta Json?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  jobs         DigitalHumanJob[]
}

model DigitalHumanJob {
  id              String              @id @default(cuid())
  avatarProfileId String
  chatMessageId   String?
  question        String
  answer          String
  status          String              @default("queued")
  provider        String              @default("mock")
  providerJobId   String?
  subtitle        String
  audioUrl        String?
  videoUrl        String?
  errorMessage    String?
  readyAt         DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  avatarProfile   DigitalHumanProfile @relation(fields: [avatarProfileId], references: [id], onDelete: Cascade)

  @@index([chatMessageId])
  @@index([status, readyAt])
}

// ============================================================================
// Longitudinal Narrative — multi-source intelligence layer
// See PRODUCT.md "标的纵向叙事" section for the full design.
// All entities anchored on SEC CIK to unify EDGAR / 13F / letter mentions.
// ============================================================================

model Entity {
  id            String   @id @default(cuid())
  type          String // 'company' | 'security' | 'master' | 'concept'
  canonicalName String
  aliases       String[] @default([])
  cik           String?  @unique // SEC Central Index Key (companies + filers)
  tribeId       String?  @unique // 'buffett' | 'lilu' | 'duan' — links to TRIBE_MEMBERS
  ticker        String?
  sector        String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  financials             Financial[]
  facts                  FinancialFact[]
  filingSections         FilingSection[]
  filingAttachments      FilingAttachment[]
  holdingsAsHolder       Holding[]               @relation("HolderEntity")
  securitiesAsCompany    Security[]              @relation("SecurityCompany")
  extSourcesAsFiler      ExtSource[]
  analyses               CompanyAnalysis[]
  businessCanvas         BusinessCanvas?
  businessCanvasVersions BusinessCanvasVersion[]
  profile                MasterProfile?

  @@index([type])
  @@index([ticker])
}

model Security {
  id              String   @id @default(cuid())
  companyEntityId String? // links to Entity(type='company'|'master via fallback metadata)
  ticker          String?
  cusip           String?  @unique
  shareClass      String?
  titleOfClass    String?
  exchange        String?
  isPrimary       Boolean  @default(false)
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company  Entity?   @relation("SecurityCompany", fields: [companyEntityId], references: [id], onDelete: SetNull)
  holdings Holding[]

  @@index([ticker])
  @@index([companyEntityId])
}

model ExtSource {
  id              String    @id @default(cuid())
  kind            String // '10k' | '10q' | '13f' | 'xbrl' | 'price'
  url             String?
  ts              DateTime?
  periodYear      Int? // e.g. 2025 — calendar year of the reporting period
  periodQuarter   Int? // 1–4 — quarter of the reporting period
  filedAt         DateTime? // SEC EDGAR accepted date
  filerEntityId   String?
  accessionNumber String? // SEC accession number, promoted out of metadata so we can enforce uniqueness per filer
  metadata        Json? // 扩展：完整的 SEC filing 元数据（accession、form、fileNumber、filmNumber、size、isXBRL、primaryDocument、acceptanceDateTime、act 等）
  createdAt       DateTime  @default(now())

  filer       Entity?            @relation(fields: [filerEntityId], references: [id], onDelete: SetNull)
  financials  Financial[]
  holdings    Holding[]
  facts       FinancialFact[]
  sections    FilingSection[]
  attachments FilingAttachment[]
  artifacts   FilingArtifact[]
  sectionExtractionJobs FilingSectionExtractionJob[]

  @@unique([filerEntityId, accessionNumber], name: "ExtSource_filer_accession_unique")
  @@index([kind, ts])
  @@index([filerEntityId])
}

model FilingSectionExtractionJob {
  id                String    @id @default(cuid())
  sourceId          String
  extractionVersion Int
  status            String    @default("pending") // pending | running | success | failed | no_sections
  attempts          Int       @default(0)
  maxAttempts       Int       @default(1)
  sectionCount      Int       @default(0)
  lastError         String?
  lastErrorCode     String?
  workerId          String?
  lockedAt          DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  nextRunAt         DateTime?
  lastDurationMs    Int?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  source ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, extractionVersion])
  @@index([status, nextRunAt])
  @@index([sourceId])
  @@index([updatedAt])
}

model Financial {
  id            String   @id @default(cuid())
  entityId      String
  sourceId      String
  periodEnd     DateTime
  periodType    String // 'FY' | 'Q1' | 'Q2' | 'Q3' | 'Q4'
  lineItem      String // 'Revenue' | 'NetIncome' | 'FreeCashFlow' | 'EPSDiluted' | 'TotalAssets' | 'OperatingCashFlow'
  value         Decimal?
  unit          String?
  rawXbrlTag    String?
  sourceFactIds String[] @default([]) // 关联哪些 FinancialFact 参与计算
  mappingRule   String? // 如 "us-gaap:RevenueFromContractWithCustomerExcludingAssessedTax"
  confidence    Float    @default(1) // 1 = 直接映射，0.5 = 多事实聚合/推断
  createdAt     DateTime @default(now())

  entity Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([entityId, periodEnd, periodType, lineItem])
  @@index([entityId, periodEnd])
}

// ============================================================================
// Truth of Source — raw 10-K data layer
// All XBRL facts, filing text sections, and attachments preserved as-is.
// ============================================================================

model FinancialFact {
  id       String @id @default(cuid())
  entityId String
  sourceId String // 关联 ExtSource

  // XBRL 身份
  taxonomy String // "us-gaap" | "ifrs-full" | "dei" | "srt"
  concept  String // 原始 concept 名

  // 数值
  value    Decimal?
  valueRaw String // 原始字符串，保留精度

  // 单位
  unit    String // "USD" | "USD/shares" | "shares" | "pure"
  unitRef String? // 原始 unitRef

  // 时间维度（XBRL context）
  periodType String // "duration" | "instant"
  startDate  DateTime? // duration 类型有 startDate
  endDate    DateTime // duration endDate 或 instant date

  // SEC 档案信息
  form      String // "10-K" | "10-K/A"
  accession String
  filedAt   DateTime?

  // 原始数据完整保留
  rawFactJson    Json // 原始 fact JSON
  rawContextJson Json // 原始 context JSON

  createdAt DateTime @default(now())

  entity Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, concept, endDate, unit])
  @@index([entityId, concept, endDate])
  @@index([entityId, endDate])
  @@index([sourceId])
}

model FilingSection {
  id       String @id @default(cuid())
  entityId String
  sourceId String // 关联 ExtSource

  section     String // "item_1_business" | "item_1a_risk_factors" | "item_2_properties" | "item_3_legal" | "item_7_mda" | "item_7a_market_risk" | "item_8_notes" | "exhibits"
  content     String // 兼容字段：新架构下保存 preview / lightweight fallback，完整文本在 textArtifact
  rawHtml     String? // 兼容字段：新架构下不再保存大 HTML，完整片段在 htmlArtifact
  outlineJson Json? // 目录树 / 标题层级
  blocksJson  Json? // 兼容字段：新架构下保存去掉 html 的轻量 blocks，完整结构在 blocksArtifact

  contentPreview    String?
  contentTextLength Int     @default(0)
  blockCount        Int     @default(0)
  extractionVersion Int     @default(1)

  textArtifactId   String?
  blocksArtifactId String?
  htmlArtifactId   String?

  extractedAt DateTime @default(now())

  entity Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  textArtifact   FilingArtifact? @relation("FilingSectionTextArtifact", fields: [textArtifactId], references: [id], onDelete: SetNull)
  blocksArtifact FilingArtifact? @relation("FilingSectionBlocksArtifact", fields: [blocksArtifactId], references: [id], onDelete: SetNull)
  htmlArtifact   FilingArtifact? @relation("FilingSectionHtmlArtifact", fields: [htmlArtifactId], references: [id], onDelete: SetNull)

  @@unique([sourceId, section])
  @@index([entityId, section])
  @@index([textArtifactId])
  @@index([blocksArtifactId])
  @@index([htmlArtifactId])
}

model FilingAttachment {
  id       String @id @default(cuid())
  entityId String
  sourceId String // 关联 ExtSource（主 10-K）

  sequence     String // "1" | "2" | "3.1" | "10.1"
  description  String // "Restated Articles of Incorporation"
  documentType String // "EX-3.1" | "EX-10.1" | "EX-21"
  documentName String // 文件名
  url          String // SEC 附件 URL

  createdAt DateTime @default(now())

  entity Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([entityId])
}

model FilingArtifact {
  id           String   @id @default(cuid())
  sourceId     String
  kind         String // Standard import writes primary_html | index_html | section_text | section_blocks. Other kinds are legacy/on-demand.
  objectKey    String   @unique
  contentType  String
  sizeBytes    BigInt
  sha256       String
  originalName String?
  sourceUrl    String?
  publicUrl    String?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  source ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  textForSections   FilingSection[] @relation("FilingSectionTextArtifact")
  blocksForSections FilingSection[] @relation("FilingSectionBlocksArtifact")
  htmlForSections   FilingSection[] @relation("FilingSectionHtmlArtifact")

  @@index([sourceId, kind])
  @@index([sha256])
}

model Holding {
  id                 String   @id @default(cuid())
  holderEntityId     String
  securityId         String
  sourceId           String
  asOfDate           DateTime
  shares             BigInt?
  valueUsd           BigInt?
  percentOfPortfolio Float?
  isNewPosition      Boolean? @default(false)
  isSoldOut          Boolean? @default(false)
  positionChangePct  Float?
  createdAt          DateTime @default(now())

  holder   Entity    @relation("HolderEntity", fields: [holderEntityId], references: [id], onDelete: Cascade)
  security Security  @relation(fields: [securityId], references: [id], onDelete: Cascade)
  source   ExtSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([holderEntityId, securityId, asOfDate])
  @@index([securityId, asOfDate])
  @@index([holderEntityId, asOfDate])
}

model CompanyNameMap {
  id          String   @id @default(cuid())
  keyType     String // 'ticker' | 'issuer'
  key         String
  nameZh      String?
  ticker      String?
  nameEnShort String?
  source      String? // 'code-dictionary' | 'manual' | 'import'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([keyType, key])
  @@index([keyType, ticker])
}

model MasterProfile {
  id          String   @id @default(cuid())
  entityId    String   @unique
  profile     Json
  source      String   @default("llm")
  version     Int      @default(1)
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
}

model CompanyAnalysis {
  id        String   @id @default(cuid())
  entityId  String   @unique
  narrative Json // { overview: {title, content}, business: {title, content} }
  moat      Json // { summary: {type, strength, durability, allocation, thesis}, dimensions: [...], notes: [...] }
  source    String   @default("claude")
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entity Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
}

model GeneratedContentVersion {
  id            String   @id @default(cuid())
  scopeType     String // entity | master | portfolio | other
  scopeId       String
  artifactType  String // company_profile | business_overview | value_analysis | master_profile | portfolio_insight
  versionSeq    Int
  payload       Json
  source        String   @default("llm")
  promptVersion String
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([scopeType, scopeId, artifactType, versionSeq])
  @@index([scopeType, scopeId, artifactType])
  @@index([artifactType])
}

model BusinessCanvas {
  id            String   @id @default(cuid())
  entityId      String   @unique
  canvas        Json // { customerSegments, valuePropositions, channels, customerRelationships, revenueStreams, keyResources, keyActivities, keyPartnerships, costStructure }
  source        String   @default("llm")
  version       Int      @default(1)
  versionSeq    Int      @default(1)
  promptVersion String   @default("business-canvas-v1")
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entity   Entity                  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  versions BusinessCanvasVersion[]
}

model BusinessCanvasVersion {
  id               String   @id @default(cuid())
  businessCanvasId String
  entityId         String
  versionSeq       Int
  canvas           Json
  source           String   @default("llm")
  promptVersion    String   @default("business-canvas-v1")
  generatedAt      DateTime @default(now())
  filingLabel      String?
  filingAccession  String?
  createdAt        DateTime @default(now())

  businessCanvas BusinessCanvas @relation(fields: [businessCanvasId], references: [id], onDelete: Cascade)
  entity         Entity         @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, versionSeq])
  @@index([businessCanvasId])
  @@index([entityId])
}

model PortfolioInsight {
  id          String   @id @default(cuid())
  masterId    String
  year        Int
  quarter     Int
  structured  Json?
  narrative   String
  source      String   @default("deepseek")
  version     Int      @default(1)
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([masterId, year, quarter])
  @@index([masterId])
}

model HomeSignalSnapshot {
  id            String   @id @default(cuid())
  scope         String   @unique
  sourceQuarter String?
  payload       Json
  version       Int      @default(1)
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model StockPrice {
  id            String   @id @default(cuid())
  ticker        String
  date          DateTime @db.Date
  open          Decimal? @db.Decimal(18, 6)
  high          Decimal? @db.Decimal(18, 6)
  low           Decimal? @db.Decimal(18, 6)
  close         Decimal  @db.Decimal(18, 6)
  volume        BigInt?
  adjustedClose Decimal? @db.Decimal(18, 6)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ticker, date])
}
