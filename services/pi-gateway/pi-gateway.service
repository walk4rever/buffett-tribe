[Unit]
Description=pi-agent-gateway
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/pi-gateway
EnvironmentFile=/home/ubuntu/pi-gateway/.env
ExecStart=/usr/bin/node --import tsx/esm src/server.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
