# Supabase — direct connection (not pgbouncer)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# Embedding API (火山引擎 / Volcengine ark)
EMBEDDING_API_KEY="your-embedding-api-key"
EMBEDDING_API_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
EMBEDDING_MODEL="doubao-embedding-large"

# search_wisdom embedding (阿里云百炼 DashScope, OpenAI-compatible mode)
DASHSCOPE_API_KEY="your-dashscope-api-key"

# pi agent 配置目录，含 models.json（自定义 provider + API key）
# 本地开发：直接复用 ~/.pi/agent（与 pi CLI 共享配置）
# 生产(air7)：复制 .pi-agent/models.json 到服务器，填入真实 key，然后指向该目录
PI_AGENT_DIR="~/.pi/agent"

# Gateway auth — shared secret between SPA and this service
AGENT_SECRET="change-me-in-production"

# Port (default 3456)
PORT=3456
